{
  "name": "pitch-studio",
  "description": "A local-first voice practice tool for the web and Android, with real-time pitch tracking, audio visualizations, recording, and an 88-key reference piano.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:soak": "node scripts/soak.mjs",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "test:recording-soak": "node scripts/recording-soak.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "pitchy": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
